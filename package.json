{
  "name": "creatoriq-workspace",
  "version": "1.0.0",
  "description": "CreatorIQ Multi-Platform Creator Analytics & Dashboard Workspace",
  "private": true,
  "scripts": {
    "start": "python run_project.py",
    "dev": "python run_project.py",
    "dev:backend": "cd backend && python manage.py runserver 8000",
    "dev:fastapi": "cd backend && uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && python test_all_apis.py",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "creatoriq",
    "analytics",
    "creator-dashboard",
    "react",
    "django",
    "fastapi"
  ],
